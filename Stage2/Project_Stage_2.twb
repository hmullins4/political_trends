      <column caption='Voter Age' datatype='real' name='[Calculation_4514014214314614784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &quot;18-29&quot; THEN [voterage:18-29]&#13;&#10;  WHEN &quot;30-44&quot; THEN [voterage: 30-44]&#13;&#10;  WHEN &quot;45-59&quot; THEN [voterage: 45-59]&#13;&#10;  WHEN &quot;60+&quot; THEN [voterage: 60+]&#13;&#10;END' />
      </column>
      <column caption='Electorate Age' datatype='real' name='[Calculation_4514014214319357954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &quot;18-29&quot; THEN [electorateage: 18-29]&#13;&#10;  WHEN &quot;30-44&quot; THEN [electorateage: 30-44]&#13;&#10;  WHEN &quot;45-59&quot; THEN [electorateage: 45-59]&#13;&#10;  WHEN &quot;60+&quot; THEN [electorateage: 60+]&#13;&#10;END' />
      </column>
      <column caption='R&amp;E' datatype='real' name='[Calculation_4514014214385229830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;  WHEN &quot;Hispanic Turnout&quot; THEN [hispanic_turnout]&#13;&#10;  WHEN &quot;Black Turnout&quot; THEN [non-hispanic_black_turnout]&#13;&#10;  WHEN &quot;White Turnout&quot; THEN [non-hispanic_white_turnout]&#13;&#10;  WHEN &quot;Other Turnout&quot; THEN [other_turnout]&#13;&#10;  WHEN &quot;Hispanic Electorate Share&quot; THEN [hispanic_electorate_share]&#13;&#10;  WHEN &quot;Black Electorate Share&quot; THEN [nhb_electorate_share]&#13;&#10;  WHEN &quot;White Electorate Share&quot; THEN [nhw_electorate_share]&#13;&#10;  WHEN &quot;Other Electorate Share&quot; THEN [other_electorate_share]&#13;&#10;END' />
      </column>
      <column caption='R&amp;E2' datatype='real' name='[Calculation_4514014214386487304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;  WHEN &quot;Hispanic Turnout&quot; THEN [hispanic_turnout]&#13;&#10;  WHEN &quot;Black Turnout&quot; THEN [non-hispanic_black_turnout]&#13;&#10;  WHEN &quot;White Turnout&quot; THEN [non-hispanic_white_turnout]&#13;&#10;  WHEN &quot;Other Turnout&quot; THEN [other_turnout]&#13;&#10;  WHEN &quot;Hispanic Electorate Share&quot; THEN [hispanic_electorate_share]&#13;&#10;  WHEN &quot;Black Electorate Share&quot; THEN [nhb_electorate_share]&#13;&#10;  WHEN &quot;White Electorate Share&quot; THEN [nhw_electorate_share]&#13;&#10;  WHEN &quot;Other Electorate Share&quot; THEN [other_electorate_share]&#13;&#10;END' />
      </column>
